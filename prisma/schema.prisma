// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Mensagem {
  id          Int      @id @default(autoincrement())
  titulo      String
  conteudo    String
  autor       String?
  dataCriacao DateTime @default(now()) @map("data_criacao")
  ativo       Int      @default(1)
  
  @@map("mensagens")
}

model Biblioteca {
  id          Int      @id @default(autoincrement())
  titulo      String
  descricao   String?
  tipo        String
  arquivo     String?
  url         String?
  dataCriacao DateTime @default(now()) @map("data_criacao")
  ativo       Int      @default(1)
  
  @@map("biblioteca")
}

model Meditacao {
  id          Int      @id @default(autoincrement())
  titulo      String
  descricao   String?
  duracao     Int?
  arquivoAudio String? @map("arquivo_audio")
  urlYoutube  String?  @map("url_youtube")
  imagem      String?
  dataCriacao DateTime @default(now()) @map("data_criacao")
  ativo       Int      @default(1)
  
  @@map("meditacoes")
}

model Admin {
  id     Int    @id @default(autoincrement())
  usuario String @unique
  senha   String
  nome    String?
  
  @@map("admins")
}

model QuizResposta {
  id          Int      @id @default(autoincrement())
  respostas   String  // JSON string
  pontuacao   Int
  porcentagem Int
  dataCriacao DateTime @default(now()) @map("data_criacao")
  
  @@map("quiz_respostas")
}

